upstream workbuddy_hub_api {
    server 127.0.0.1:8100;
    keepalive 16;
}

server {
    listen 443 ssl http2;
    server_name hub.example.internal;

    root /var/www/workbuddy;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    location /api/ {
        proxy_pass http://workbuddy_hub_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 3s;
        proxy_read_timeout 30s;
    }

    location = /health {
        proxy_pass http://workbuddy_hub_api;
    }

    location = /ready {
        proxy_pass http://workbuddy_hub_api;
    }

    # TLS certificate paths and the OIDC authentication layer are supplied by
    # the deployment environment. Do not expose the local-header auth mode.
}
