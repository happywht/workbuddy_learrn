HUB_IMAGE=workbuddy-hub-api:local
HUB_PORT=8100
AUTH_MODE=local_header
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
OIDC_GROUPS_CLAIM=groups
OIDC_DEPARTMENT_CLAIM=departments
OIDC_DEPARTMENT_GROUP_PREFIX=department:
OIDC_JWKS_CACHE_SECONDS=300
OIDC_CLOCK_SKEW_SECONDS=30
POSTGRES_DB=workbuddy_hub
POSTGRES_USER=hub
POSTGRES_PASSWORD=change-me-in-local-only
POSTGRES_PORT=55432

# Run SkillHub and AgentTeams separately with their pinned upstream release.
SKILLHUB_BASE_URL=http://host.docker.internal:8080
SKILLHUB_TOKEN=
SKILLHUB_PUBLISH_PATH=
AGENTTEAMS_BASE_URL=http://host.docker.internal:18080
AGENTTEAMS_TOKEN=
AGENTTEAMS_MATRIX_URL=http://host.docker.internal:18080
AGENTTEAMS_MATRIX_TOKEN=
AGENTTEAMS_MATRIX_USER_ID=
AGENTTEAMS_MATRIX_MEDIA_SERVER_ALLOWLIST=
AGENTTEAMS_MATRIX_MEDIA_MAX_BYTES=26214400
