{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbuddy-hub.local/schemas/package.schema.json",
  "title": "WorkBuddy Hub Package",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "kind", "summary", "scope", "inputs", "outputs", "permissions", "human_review", "sanitization"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "name": { "type": "string", "minLength": 2, "maxLength": 80 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "kind": { "enum": ["case", "skill"] },
    "summary": { "type": "string", "minLength": 8, "maxLength": 240 },
    "scope": { "enum": ["personal", "department", "organization"] },
    "target_department_id": { "type": ["string", "null"] },
    "tags": { "type": "array", "items": { "type": "string", "maxLength": 30 }, "maxItems": 12, "uniqueItems": true },
    "inputs": { "type": "array", "items": { "type": "object" } },
    "outputs": { "type": "array", "items": { "type": "object" } },
    "permissions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "human_review": { "type": "array", "items": { "type": "string" } },
    "sanitization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "changes"],
      "properties": {
        "status": { "enum": ["passed", "needs_confirmation", "blocked"] },
        "changes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "links": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  }
}
