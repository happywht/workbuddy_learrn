HUB_ENV=local
HUB_AUTH_MODE=local_header
HUB_OIDC_ISSUER_URL=
HUB_OIDC_AUDIENCE=
HUB_OIDC_GROUPS_CLAIM=groups
HUB_OIDC_DEPARTMENT_CLAIM=departments
HUB_OIDC_DEPARTMENT_GROUP_PREFIX=department:
HUB_OIDC_JWKS_CACHE_SECONDS=300
HUB_OIDC_CLOCK_SKEW_SECONDS=30
HUB_DATABASE_URL=sqlite:///./var/hub.db
HUB_REGISTRY_PATH=../../workbuddy-hub/data/registry.json
HUB_SEED_DEMO_CASES=true
HUB_CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
HUB_OTEL_SERVICE_NAME=workbuddy-hub-api
HUB_OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
HUB_OTEL_TRACE_SAMPLE_RATIO=0.1
HUB_OTEL_EXPORT_TIMEOUT_SECONDS=5
HUB_SKILLHUB_BASE_URL=
HUB_SKILLHUB_TOKEN=
HUB_SKILLHUB_PUBLISH_PATH=
HUB_SKILLHUB_TIMEOUT_SECONDS=10
HUB_SKILLHUB_HASH_MAX_BYTES=26214400
HUB_AGENTTEAMS_BASE_URL=
HUB_AGENTTEAMS_TOKEN=
HUB_AGENTTEAMS_MATRIX_URL=
HUB_AGENTTEAMS_MATRIX_TOKEN=
HUB_AGENTTEAMS_MATRIX_USER_ID=
HUB_AGENTTEAMS_MATRIX_MEDIA_SERVER_ALLOWLIST=
HUB_AGENTTEAMS_MATRIX_MEDIA_MAX_BYTES=26214400
HUB_AGENTTEAMS_TIMEOUT_SECONDS=10
